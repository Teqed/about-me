/*
  Cache-Control: public, no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-0Q6fGGSUKwK+/3SJBczIKJhPiegLGa3K/Z0PRQ8xAFI='; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src https://feed.quilling.dev; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/img/nojs/*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/img/avatar-*
  ! Cache-Control
  Cache-Control: public, max-age=86400

/favicon*
  ! Cache-Control
  Cache-Control: public, max-age=604800

/og.png
  ! Cache-Control
  Cache-Control: public, max-age=604800

/ssh.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/atproto-did
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
